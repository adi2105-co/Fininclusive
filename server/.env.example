# Copy this file to ".env" and edit. Never commit ".env" to GitHub.
PORT=5000
NODE_ENV=development

# Long random strings. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
DATA_KEY=change_me_to_another_long_random_string

# Email OTP via Gmail (optional for local demo - if empty, OTP is printed in the terminal AND shown on screen)
# 1) Turn on 2-Step Verification on your Google account
# 2) Create an "App password": https://myaccount.google.com/apppasswords
# Other providers (leave SMTP_HOST empty for Gmail). Examples:
#   Outlook: smtp-mail.outlook.com / 587    Brevo: smtp-relay.brevo.com / 587    Zoho: smtp.zoho.in / 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FinInclusive <yourgmail@gmail.com>"

# Seed admin / banker account (change before deploying!)
ADMIN_EMAIL=admin@fininclusive.app
ADMIN_PASSWORD=Admin@12345
